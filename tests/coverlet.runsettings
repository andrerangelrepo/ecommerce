<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared coverage configuration, referenced via `dotnet test -s tests/coverlet.runsettings`.
  OpenCover is the format SonarScanner for .NET expects (sonar.cs.opencover.reportsPaths).

  Exclusions here only affect the coverage percentage, not static analysis. Migrations are
  generated by EF Core (never hand written, so testing them proves nothing); Program.cs is a
  composition root with no branching logic of its own to cover.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>opencover</Format>
          <ExcludeByFile>**/Migrations/**/*.cs,**/Program.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
