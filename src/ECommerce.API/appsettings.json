{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Data Source=orders.db"
  },
  "Jwt": {
    "Key": "replace-this-development-key-with-a-secure-key",
    "Issuer": "ECommerce.Api",
    "Audience": "ECommerce.Client",
    "ExpirationMinutes": 60
  }
}
