# Visual Studio cache/options directory
.vs/

# Files built by Visual Studio
*.sln.docstates

# NuGet Packages
*.nupkg
*.snupkg
# NuGet v3's project.json files makes it easier to support multiple targets
# (ex: .NET Framework, .NET Core, UWP, etc.) without having to manually edit the project file.
# More info: https://aka.ms/flexible-project-files
project.json
project.lock.json
packages.lock.json

# The packages folder can be ignored because of Package Restore
**/packages/*
# except build/, which is used as an MSBuild target.
!**/packages/build/
# Uncomment if necessary however generally it will be regenerated when needed
#!**/packages/repositories.config
# NuGet v3's project.json files makes it easier to support multiple targets
# (ex: .NET Framework, .NET Core, UWP, etc.) without having to manually edit the project file.
# More info: https://aka.ms/flexible-project-files
project.json
project.lock.json
packages.lock.json

# Database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Environment variables
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Test Results
TestResults/
coverage/
*.trx
